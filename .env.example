# ====================================================================
# Antigravity Hub Bridge Configuration
# ====================================================================

# ---------------- Service Toggles ----------------
# Enable or disable WebUI (http://host:port)
ENABLE_WEBUI=true

# Enable or disable Telegram Bot Polling
# NOTE: Set to false if you are running Telegram Bot in another directory
# to prevent polling conflicts with the Telegram Bot API.
ENABLE_TELEGRAM=false

# ---------------- WebUI Configuration ----------------
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8000
WEBUI_TITLE=Antigravity Hub
WEBUI_AUTH_ENABLED=false
WEBUI_PASSWORD=

# ---------------- Telegram Bot Configuration ----------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
AUTO_WHITELIST_FIRST_USER=true

# ---------------- Antigravity CLI Configuration ----------------
AGY_BIN_PATH=/root/.local/bin/agy
DEFAULT_WORKSPACE=/root
DEFAULT_MODEL=gemini-3.7-flash-high
DEFAULT_EFFORT=high
AUTO_APPROVE_PERMISSIONS=true

# ---------------- Streaming & UI ----------------
STREAM_UPDATES=true
STREAM_EDIT_INTERVAL=1.5

# ---------------- Logging ----------------
LOG_LEVEL=INFO
