# ====================================================================
# Antigravity Telegram Bridge Configuration Example
# ====================================================================

# Telegram Bot Token (Get one from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Allowed Telegram User IDs (Comma-separated, e.g. 12345678,87654321)
ALLOWED_USER_IDS=

# Admin User IDs (Comma-separated)
ADMIN_USER_IDS=

# Auto-whitelist first user as Admin if list is empty
AUTO_WHITELIST_FIRST_USER=true

# Antigravity CLI binary path
AGY_BIN_PATH=/root/.local/bin/agy

# Default workspace directory for Antigravity executions
DEFAULT_WORKSPACE=/root

# Default AI Model (e.g. gemini-3.7-flash-high, gemini-3.1-pro-high, claude-sonnet-4-6)
DEFAULT_MODEL=gemini-3.7-flash-high

# Default Reasoning Effort (low, medium, high)
DEFAULT_EFFORT=high

# Auto-approve tool permissions (--dangerously-skip-permissions)
AUTO_APPROVE_PERMISSIONS=true

# Live progress status updates (streaming)
STREAM_UPDATES=true
STREAM_EDIT_INTERVAL=1.5

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
